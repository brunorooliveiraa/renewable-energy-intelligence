# String de conexao Pooled do Neon PostgreSQL (usada pela API serverless FastAPI na Vercel).
# Nunca commite credenciais reais: copie este arquivo para .env no ambiente local
# e configure as variaveis no painel da Vercel em producao.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# String de conexao direta (unpooled) do Neon PostgreSQL, recomendada para migracoes
# de esquema (sql/schema.sql) e cargas em lote do pipeline ETL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
